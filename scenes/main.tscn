[node name="Main" type="Node2D" node_paths=PackedStringArray("runner", "map_view", "camera")]
script = ExtResource("4_main")
runner = NodePath("MatchRunner")
map_view = NodePath("MapView")
camera = NodePath("Camera")

[node name="MatchRunner" type="Node" parent="."]
script = ExtResource("7_runner")
