[node name="UnitLayer" type="Node2D" parent="." node_paths=PackedStringArray("runner", "camera")]
script = ExtResource("9_units")
runner = NodePath("../MatchRunner")
camera = NodePath("../Camera")

[node name="HealthBarLayer" type="Node2D" parent="." node_paths=PackedStringArray("runner", "unit_layer")]
