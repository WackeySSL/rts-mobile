[gd_resource type="Resource" script_class="TerrainKitDef" format=3]

[ext_resource type="Script" path="res://game/view/TerrainKitDef.gd" id="1_kit"]

; The terrain kit's art mapping (ADR 0053 section 7, plan row P656c): which PNG draws which terrain,
; kind and mask or variant. Art only, no balance number. The masks are the neighbours that differ
; (edge neighbours ne, se, sw, nw; diagonal ones n, e, s, w):
;   blend  side_<edge>: that edge neighbour is a higher-priority terrain; corner_<diag>: only that
;          diagonal neighbour is. Drawn on the lower terrain's cell, in the higher terrain's look.
;   lip    (rock) and shore (water), on the rock or water cell itself, towards the other terrain:
;          side_<edge> one edge neighbour differs, outer_<diag> the two edge neighbours at that
;          corner differ, inner_<diag> only the diagonal neighbour differs.
;   road   <edge>_<edge>: the road leaves the cell through those two edges; it replaces the base.
; priority: highest first. A higher terrain's blend is drawn on the cells of a lower one.

[resource]
script = ExtResource("1_kit")
terrains = PackedStringArray("grass", "sand", "scrub", "rock", "water", "ore")
variants = 4
boulder_one_in = Dictionary[StringName, int]({
&"grass": 48,
&"rock": 16
})
priority = PackedStringArray("ore", "scrub", "sand", "grass")
masks = Dictionary[StringName, PackedStringArray]({
&"base": PackedStringArray("0", "1", "2", "3"),
&"blend": PackedStringArray("side_ne", "side_se", "side_sw", "side_nw", "corner_n", "corner_e", "corner_s", "corner_w"),
&"lip": PackedStringArray("side_ne", "side_se", "side_sw", "side_nw", "outer_n", "outer_e", "outer_s", "outer_w", "inner_n", "inner_e", "inner_s", "inner_w"),
&"shore": PackedStringArray("side_ne", "side_se", "side_sw", "side_nw", "outer_n", "outer_e", "outer_s", "outer_w", "inner_n", "inner_e", "inner_s", "inner_w"),
&"road": PackedStringArray("nw_se", "ne_sw", "nw_ne", "ne_se", "se_sw", "sw_nw")
})
kinds = Dictionary[StringName, PackedStringArray]({
&"grass": PackedStringArray("base", "road"),
&"sand": PackedStringArray("base", "blend", "road"),
&"scrub": PackedStringArray("base", "blend"),
&"rock": PackedStringArray("base", "lip"),
&"water": PackedStringArray("base", "shore"),
&"ore": PackedStringArray("base", "blend")
})
pieces = Dictionary[StringName, String]({
&"grass/base/0": "grass_base_0.png",
&"grass/base/1": "grass_base_1.png",
