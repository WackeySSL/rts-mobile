&"grass/road/nw_ne": "road_grass_nw_ne.png",
&"grass/road/ne_se": "road_grass_ne_se.png",
&"grass/road/se_sw": "road_grass_se_sw.png",
&"grass/road/sw_nw": "road_grass_sw_nw.png",
