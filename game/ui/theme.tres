[resource]
; The body face: Chakra Petch 500 (the file's header says where the other weights go).
default_font = ExtResource("1_chakra_500")
; The long-press anchor and the selection box (BoxOverlay.gd): fill, dark pass, stroke.
BoxOverlay/colors/fill = Color(1, 1, 1, 0.15)
BoxOverlay/colors/outline = Color(0.10980392, 0.12941177, 0.15294118, 1)
BoxOverlay/colors/stroke = Color(1, 1, 1, 1)
; The ArmyBar's buttons: HUD numbers, 18 dp.
Button/font_sizes/font_size = 18
; The Dev button of the main screen: 40 base px, not dp (see metadata/base_px).
DevButton/base_type = &"Button"
DevButton/font_sizes/font_size = 40
; The selection panel's unit names, 16 dp, and its counts and total (NumberLabel), 20 dp.
Label/font_sizes/font_size = 16
NumberLabel/base_type = &"Label"
NumberLabel/font_sizes/font_size = 20
NumberLabel/fonts/font = ExtResource("2_chakra_600")
; The selection panel's backdrop.
SelectionPanel/base_type = &"PanelContainer"
SelectionPanel/styles/panel = SubResource("StyleBoxFlat_backdrop")
; The perf card's backdrop (PerfHud.gd, a developer tool): the same box as the selection panel's.
PerfCard/base_type = &"PanelContainer"
PerfCard/styles/panel = SubResource("StyleBoxFlat_backdrop")
; The build sidebar (BuildSidebar.gd, plan P85): its backdrop. (Its credits, power and warning tints went
; to the economy pill's HudTokens with P119.)
BuildSidebar/base_type = &"PanelContainer"
BuildSidebar/styles/panel = SubResource("StyleBoxFlat_sidebar")
; The minimap's camera frame (Minimap.gd, plan P88; RadarScope.gd draws the same frame, P121): a white line
; on a dark edge, so it reads on every terrain. The picture's tint is white, so the texels show as painted.
Minimap/base_type = &"Control"
Minimap/colors/frame = Color(1, 1, 1, 1)
Minimap/colors/frame_edge = Color(0.06, 0.08, 0.11, 0.9)
Minimap/colors/picture = Color(1, 1, 1, 1)
; The three tabs: the icon is tinted #9AA5B1 at rest and white when the tab is open.
SidebarTab/base_type = &"Button"
SidebarTab/colors/icon_focus_color = Color(0.60392157, 0.64705882, 0.69411765, 1)
SidebarTab/colors/icon_hover_color = Color(0.60392157, 0.64705882, 0.69411765, 1)
SidebarTab/colors/icon_hover_pressed_color = Color(1, 1, 1, 1)
SidebarTab/colors/icon_normal_color = Color(0.60392157, 0.64705882, 0.69411765, 1)
SidebarTab/colors/icon_pressed_color = Color(1, 1, 1, 1)
SidebarTab/styles/focus = SubResource("StyleBoxEmpty_focus")
SidebarTab/styles/hover = SubResource("StyleBoxFlat_tab")
SidebarTab/styles/hover_pressed = SubResource("StyleBoxFlat_tab_open")
SidebarTab/styles/normal = SubResource("StyleBoxFlat_tab")
SidebarTab/styles/pressed = SubResource("StyleBoxFlat_tab_open")
; The Build button of the collapsed menu (BuildSidebar, ADR 0024 section 6): the tab's plates, its glyph
; (glyph_menu_open, STYLE.md: none) in white, the open tab's colour, at rest and pressed.
BuildButton/base_type = &"SidebarTab"
BuildButton/colors/icon_focus_color = Color(1, 1, 1, 1)
BuildButton/colors/icon_hover_color = Color(1, 1, 1, 1)
BuildButton/colors/icon_hover_pressed_color = Color(1, 1, 1, 1)
BuildButton/colors/icon_normal_color = Color(1, 1, 1, 1)
BuildButton/colors/icon_pressed_color = Color(1, 1, 1, 1)
; The Ready badge (BuildSidebar, ADR 0024 section 9): the READY banner's plate, the item's card and the
; word in the banner's 14 dp dark type (5.8:1 on the green); a white edge while the finger is on it.
ReadyBadge/base_type = &"Button"
ReadyBadge/colors/font_color = Color(0.06, 0.08, 0.11, 1)
ReadyBadge/colors/font_focus_color = Color(0.06, 0.08, 0.11, 1)
ReadyBadge/colors/font_hover_color = Color(0.06, 0.08, 0.11, 1)
ReadyBadge/colors/font_hover_pressed_color = Color(0.06, 0.08, 0.11, 1)
ReadyBadge/colors/font_pressed_color = Color(0.06, 0.08, 0.11, 1)
ReadyBadge/font_sizes/font_size = 14
ReadyBadge/styles/focus = SubResource("StyleBoxEmpty_focus")
ReadyBadge/styles/hover = SubResource("StyleBoxFlat_badge")
ReadyBadge/styles/hover_pressed = SubResource("StyleBoxFlat_badge_pressed")
ReadyBadge/styles/normal = SubResource("StyleBoxFlat_badge")
ReadyBadge/styles/pressed = SubResource("StyleBoxFlat_badge_pressed")
; The build item tiles (ItemTile.gd, plan P85b): the icon (dimmed behind a padlock), the fill that rises
; over it with the head's progress, the padlock (#9AA5B1) and the stripes of a tile that cannot take an
; item (the warning amber, half clear). The cost and the count are 18 dp numbers on a plate (the cost
; amber when the money is short), the banner is 14 dp, dark on the green (5.8:1). The name under the
; plate of a landscape card is 14 dp, white on the tile's dark plate.
ItemTile/base_type = &"Button"
ItemTile/colors/fill = Color(1, 1, 1, 0.4)
ItemTile/colors/icon = Color(1, 1, 1, 1)
ItemTile/colors/icon_locked = Color(1, 1, 1, 0.4)
ItemTile/colors/lock = Color(0.60392157, 0.64705882, 0.69411765, 1)
ItemTile/colors/stripe = Color(0.96078431, 0.64705882, 0.14117647, 0.55)
ItemTile/styles/hover = SubResource("StyleBoxFlat_tab")
ItemTile/styles/hover_pressed = SubResource("StyleBoxFlat_tab_open")
ItemTile/styles/normal = SubResource("StyleBoxFlat_tab")
ItemTile/styles/pressed = SubResource("StyleBoxFlat_tab_open")
ItemCost/base_type = &"NumberLabel"
ItemCost/colors/font_color = Color(1, 1, 1, 1)
ItemCost/font_sizes/font_size = 18
ItemCost/fonts/font = ExtResource("3_chakra_700")
ItemCost/styles/normal = SubResource("StyleBoxFlat_plate")
ItemCostLow/base_type = &"ItemCost"
ItemCostLow/colors/font_color = Color(0.96078431, 0.64705882, 0.14117647, 1)
ItemBanner/base_type = &"Label"
ItemBanner/colors/font_color = Color(0.06, 0.08, 0.11, 1)
ItemBanner/font_sizes/font_size = 14
ItemBanner/styles/normal = SubResource("StyleBoxFlat_power")
ItemCaption/base_type = &"Label"
ItemCaption/colors/font_color = Color(1, 1, 1, 1)
ItemCaption/font_sizes/font_size = 14
; The strike controls (StrikeButton.gd, StrikeControls.gd, plan P112): the item tile's plates. The ring
; around the strike button's card is drawn in these colours: the track, the charge so far and the full
; ring of a strike that can fire (the power bar's green). The check mark is green, the X white.
StrikeButton/base_type = &"ItemTile"
StrikeButton/colors/ring_charge = Color(0.9, 0.93, 0.95, 1)
StrikeButton/colors/ring_ready = Color(0.18823529, 0.64313725, 0.42352941, 1)
StrikeButton/colors/ring_track = Color(0.3, 0.3, 0.3, 1)
StrikeButton/styles/disabled = SubResource("StyleBoxFlat_tab")
StrikeButton/styles/focus = SubResource("StyleBoxEmpty_focus")
StrikeConfirm/base_type = &"StrikeButton"
StrikeConfirm/colors/icon_hover_color = Color(0.18823529, 0.64313725, 0.42352941, 1)
StrikeConfirm/colors/icon_hover_pressed_color = Color(0.18823529, 0.64313725, 0.42352941, 1)
StrikeConfirm/colors/icon_normal_color = Color(0.18823529, 0.64313725, 0.42352941, 1)
StrikeConfirm/colors/icon_pressed_color = Color(0.18823529, 0.64313725, 0.42352941, 1)
; The power bar and its low-power look.
PowerBar/base_type = &"ProgressBar"
PowerBar/styles/background = SubResource("StyleBoxFlat_track")
PowerBar/styles/fill = SubResource("StyleBoxFlat_power")
PowerBarLow/base_type = &"ProgressBar"
PowerBarLow/styles/background = SubResource("StyleBoxFlat_track")
PowerBarLow/styles/fill = SubResource("StyleBoxFlat_low_power")
; The numbers in the power bar, 18 dp (the least a HUD number may be). On the green bar they sit across
; the fill and the dark track: white with a dark edge (the size of the edge is set in code, in dp), 3.2:1
; against the fill without the edge. On low power the bar is full and danger red under all of them: dark and
; with no edge, 5.9:1 against the red (WCAG AA asks 4.5:1).
PowerNumber/base_type = &"NumberLabel"
PowerNumber/colors/font_color = Color(1, 1, 1, 1)
PowerNumber/colors/font_outline_color = Color(0.06, 0.08, 0.11, 1)
PowerNumber/font_sizes/font_size = 18
PowerNumber/fonts/font = ExtResource("3_chakra_700")
PowerNumberLow/base_type = &"NumberLabel"
PowerNumberLow/colors/font_color = Color(0.06, 0.08, 0.11, 1)
PowerNumberLow/colors/font_outline_color = Color(0.06, 0.08, 0.11, 0)
PowerNumberLow/font_sizes/font_size = 18
PowerNumberLow/fonts/font = ExtResource("3_chakra_700")
; The HUD v2 tokens (P118, ADR 0025 section 13; STYLE.md "Palette"): the panel's rgba(10, 14, 17,
; 0.84) for a draw call that is not a StyleBox (the radar scope), its edge #2C383E, money and power
; #F2C14E, danger #FF5A3C, ok and income #6EDC5F, and the text on the dark panel, white. The design's
; fixed enemy colour #FF9446 is not a token: rows on the radar keep their team colours.
HudTokens/base_type = &"Control"
HudTokens/colors/border = Color(0.17254902, 0.21960784, 0.24313725, 1)
HudTokens/colors/danger = Color(1, 0.35294118, 0.23529412, 1)
HudTokens/colors/money = Color(0.94901961, 0.75686275, 0.30588235, 1)
HudTokens/colors/ok = Color(0.43137255, 0.8627451, 0.37254902, 1)
HudTokens/colors/panel = Color(0.03921569, 0.05490196, 0.06666667, 0.84)
HudTokens/colors/text = Color(1, 1, 1, 1)
HudPanel/base_type = &"PanelContainer"
HudPanel/styles/panel = SubResource("StyleBoxFlat_hud_panel")
; The accent of each side (ADR 0025 section 13): the faction of the local player's own rows, read as
; get_theme_color(&"accent", &"AccentRenew") and so on. Accent never carries meaning alone. Lumen
; Accord (renew): cyan, the design's values; the text on it is 5.9:1. Derrick League (fossil): orange
; for its flare stacks and amber lamps, picked by the two checks of the ADR: the accent's hue is 25.4
; degrees and the light's 25.8, each at least 16 degrees from danger (9.2) and from money (42.1),
; and the text on the accent is 5.7:1 (4.5:1 asked). tests/ui/test_ui_theme_fonts.gd pins both.
AccentRenew/base_type = &"Control"
AccentRenew/colors/accent = Color(0.12156863, 0.65098039, 0.78431373, 1)
AccentRenew/colors/light = Color(0.38431373, 0.83921569, 0.93333333, 1)
AccentRenew/colors/on_accent = Color(0.01960784, 0.1254902, 0.16470588, 1)
AccentFossil/base_type = &"Control"
AccentFossil/colors/accent = Color(0.87843137, 0.4627451, 0.15686275, 1)
AccentFossil/colors/light = Color(1, 0.63529412, 0.36078431, 1)
AccentFossil/colors/on_accent = Color(0.16470588, 0.07843137, 0.01960784, 1)
; Buttons and titles: Big Shoulders Display ExtraBold, upper case written in the text itself (a
; Button has no case property, a Label has `uppercase`: one rule serves both), white. The size is
; dp, the tracking base px (the file's header): a button 22 dp with 4 px, a title 28 dp with 5 px,
; a big title 36 dp with 6 px.
CapsButton/base_type = &"Button"
CapsButton/colors/font_color = Color(1, 1, 1, 1)
CapsButton/colors/font_focus_color = Color(1, 1, 1, 1)
CapsButton/colors/font_hover_color = Color(1, 1, 1, 1)
CapsButton/colors/font_hover_pressed_color = Color(1, 1, 1, 1)
CapsButton/colors/font_pressed_color = Color(1, 1, 1, 1)
CapsButton/font_sizes/font_size = 22
CapsButton/fonts/font = SubResource("FontVariation_caps_button")
CapsTitle/base_type = &"Label"
CapsTitle/colors/font_color = Color(1, 1, 1, 1)
CapsTitle/font_sizes/font_size = 28
CapsTitle/fonts/font = SubResource("FontVariation_caps_title")
CapsBigTitle/base_type = &"Label"
CapsBigTitle/colors/font_color = Color(1, 1, 1, 1)
CapsBigTitle/font_sizes/font_size = 36
CapsBigTitle/fonts/font = SubResource("FontVariation_caps_big_title")
; The economy pill (EconomyPill.gd, P119, ADR 0025 section 3): the HUD panel's look; on low power the
; same with a thick danger red edge. PillWord is the word "LOW POWER" in the power bar: the caps face
; at 14 dp (the body text's least), dark on the red bar (5.9:1).
EconomyPill/base_type = &"PanelContainer"
EconomyPill/styles/panel = SubResource("StyleBoxFlat_pill")
; The low-power pulse (EconomyPill.gd, P89): the plate, edge and triangle breathe between pulse_full (white)
; and pulse_dim (white at 0.6); the word stays at full strength.
EconomyPill/colors/pulse_full = Color(1, 1, 1, 1)
EconomyPill/colors/pulse_dim = Color(1, 1, 1, 0.6)
EconomyPillLow/base_type = &"EconomyPill"
EconomyPillLow/styles/panel = SubResource("StyleBoxFlat_pill_low")
EconomyChipLoss/base_type = &"PanelContainer"
EconomyChipLoss/styles/panel = SubResource("StyleBoxFlat_chip_loss")
EconomyChipGain/base_type = &"PanelContainer"
EconomyChipGain/styles/panel = SubResource("StyleBoxFlat_chip_gain")
EconomyConsumer/base_type = &"PanelContainer"
EconomyConsumer/styles/panel = SubResource("StyleBoxFlat_consumer")
PillWord/base_type = &"Label"
PillWord/colors/font_color = Color(0.06, 0.08, 0.11, 1)
PillWord/font_sizes/font_size = 14
PillWord/fonts/font = SubResource("FontVariation_pill_word")
; The result screen (ResultScreen.gd, plan P90): the tint of the emblem, STYLE.md "Icons and glyphs"
; (glyph_victory #30A46C, glyph_defeat #E5484D, glyph_draw #9AA5B1); the word beside it says the rest.
ResultScreen/base_type = &"Control"
ResultScreen/colors/defeat = Color(0.8980392, 0.28235295, 0.3019608, 1)
ResultScreen/colors/draw = Color(0.60392157, 0.64705882, 0.69411765, 1)
ResultScreen/colors/victory = Color(0.18823529, 0.64313725, 0.42352941, 1)
Scrim/base_type = &"PanelContainer"
Scrim/styles/panel = SubResource("StyleBoxFlat_scrim")
metadata/base_px = PackedStringArray("DevButton/font_sizes/font_size", "CapsButton/fonts/font", "CapsTitle/fonts/font", "CapsBigTitle/fonts/font", "PillWord/fonts/font")
