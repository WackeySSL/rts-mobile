; The HUD's one Theme (plan row P58, Michael's decision of 2026-10-15): the look of the HUD's
; Controls lives here, so a new look is this file alone (STYLE.md "Reskin"). It holds the font
; sizes, the selection panel's backdrop and the colours of the selection box and anchor. The text
; and button colours, the Button StyleBoxes and the HUD font are the engine's defaults and are
; not in this file: a restyle adds them here (Label/colors/font_color, Button/styles/normal, a
; Font) with no code change. main.tscn sets the theme on the Controls under Hud (Hud/SafeArea and
; Hud/BoxOverlay); every Control below inherits it, and so does a HUD root added later with this
; theme on it. A new font goes under assets/art/fonts/ (CREDITS.md row, Licences screen) and is
; referenced from here only.
; The backdrop has a palette row in STYLE.md ("HUD panel backdrop"); this file is its value of
; record. BoxOverlay's fill and outline are also FeedbackStyle.FILL and OUTLINE, which the
; world-space move markers draw with (game/view): a new palette changes both.
;
; Sizes are dp: HudTheme.gd turns every font size and every StyleBox size (content margins,
; corner radii, border widths, expand margins, shadows, a line's thickness and grow) into px on a
; resize and gives the HUD roots that copy as their theme. Not scaled: a StyleBoxTexture's texture
; margins (they cut the picture, in texture px), the theme's constants (a font's outline_size too:
; layout stays in code, in dp through UiScale) and the StyleBox properties that are not sizes:
; skew (a shear ratio, the same angle on every screen), corner_detail (a count) and
; anti_aliasing_size (the soft edge, 1 px). Scale a constant in HudTheme.scaled() before putting
; one here. An entry that stays in base px is listed in metadata/base_px by its path in this file.
; Type variations (DevButton, NumberLabel, SelectionPanel) are set by theme_type_variation on the
; node, once, in main.tscn or at build in the script.
[gd_resource type="Theme" format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_backdrop"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.06, 0.08, 0.11, 0.78)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[resource]
; The long-press anchor and the selection box (BoxOverlay.gd): fill, dark pass, stroke.
BoxOverlay/colors/fill = Color(1, 1, 1, 0.15)
BoxOverlay/colors/outline = Color(0.10980392, 0.12941177, 0.15294118, 1)
BoxOverlay/colors/stroke = Color(1, 1, 1, 1)
; The ArmyBar's buttons: HUD numbers, 18 dp.
Button/font_sizes/font_size = 18
; The Dev button of the main screen: 40 base px, not dp (see metadata/base_px).
DevButton/base_type = &"Button"
DevButton/font_sizes/font_size = 40
; The selection panel's unit names, 16 dp, and its counts and total (NumberLabel), 20 dp.
Label/font_sizes/font_size = 16
NumberLabel/base_type = &"Label"
NumberLabel/font_sizes/font_size = 20
; The selection panel's backdrop.
SelectionPanel/base_type = &"PanelContainer"
SelectionPanel/styles/panel = SubResource("StyleBoxFlat_backdrop")
metadata/base_px = PackedStringArray("DevButton/font_sizes/font_size")
