[gd_resource type="Resource" script_class="TrophyCatalog" format=3]

[ext_resource type="Script" path="res://game/meta/TrophyCatalog.gd" id="1_cat"]
[ext_resource type="Script" path="res://game/meta/TrophyDef.gd" id="2_def"]

[sub_resource type="Resource" id="Trophy_briefed"]
