[resource]
script = ExtResource("1_cat")
trophies = Array[ExtResource("2_def")]([SubResource("Trophy_briefed"), SubResource("Trophy_fully_drilled"), SubResource("Trophy_first_sortie"), SubResource("Trophy_ground_won"), SubResource("Trophy_warm_up"), SubResource("Trophy_even_footing"), SubResource("Trophy_iron_nerve"), SubResource("Trophy_ironward_honours"), SubResource("Trophy_facet_honours"), SubResource("Trophy_flats_fords_crags"), SubResource("Trophy_no_easy_ground"), SubResource("Trophy_short_work"), SubResource("Trophy_unbroken"), SubResource("Trophy_clean_sheet"), SubResource("Trophy_seasoned"), SubResource("Trophy_long_haul")])
