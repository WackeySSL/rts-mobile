class_name ArtGen
extends RefCounted
## The art generator (ADR 0023 section 5): models in, SVG frames out, nothing random and nothing
## timed, so two runs give identical bytes. `build` returns every file of one model as text,
## keyed by its `res://` path: the frames of its parts and its cast shadow, its sheet and its item
## card; `scripts/gen-art.sh` writes them, `tests/art` compares them with the committed files. A
## part's frames share one canvas and one anchor, the union over all of its directions
## (`layouts`), which is what an atlas sheet needs. A pose part (ADR 0027 section 4) has several
## frames per direction, each drawn from the model's moves of that frame, and its files end in
## `_f<K>`.

const MODELS_DIR: String = "res://assets/art/models"
const OUT_DIR: String = IsoSheetDef.ROOT
const ICON_DIR: String = "res://assets/art/iso/icons"
## "Keep File": the SVG text is exported as it is, and the match-start bake reads it.
const IMPORT_TEXT: String = '[remap]\n\nimporter="keep"\n'
const MARKER: String = "generated by tools/artgen"  ## In the first line of every generated frame.
const MARGIN_PX: int = 2  ## Round the content of a frame: the edge reaches one px past a point.
const TILE_W_PX: int = 128  ## A tile on the ground at 2x is 128 x 64.
## A damage patch reaches this far below its stage's cut row, so a rounding or a filter seam at the
## cut is covered by it (ADR 0028 section 3): at least one texel at any bake scale.
const CUT_OVERLAP_PX: int = 4
## `damage_cut` of a stage that changes nothing.
const NO_CUT: int = -2147483648


## Where a part's frames lie in their canvas (all in px at 2x).
class Layout:
	extends RefCounted
	var size: Vector2i = Vector2i.ZERO
	var origin: Vector2i = Vector2i.ZERO  ## The model's origin: a unit's ground point.
	var anchor: Vector2i = Vector2i.ZERO  ## A unit's ground point, a building's back corner.


## The frames of one part: its directions, and the polygons of each frame (an Array of
## `ArtRender.Poly`) in the order direction, then frame: `polys[i * frames + k]` is frame `k` of
## direction `dirs[i]`. A part that is not a pose part has `frames` 1.
class Shot:
	extends RefCounted
	var layout: Layout = null
	var dirs: Array[int] = []
	var frames: int = 1
	var polys: Array[Array] = []
	var cut: int = 0  ## A damage patch: the stage's cut row in the body's canvas.


## The model files, sorted.
static func model_paths() -> Array[String]:
	var found: Array[String] = []
	for faction: String in DirAccess.get_directories_at(MODELS_DIR):
		for file: String in DirAccess.get_files_at(MODELS_DIR.path_join(faction)):
			if tres_name(file) != "":
				found.append(MODELS_DIR.path_join(faction).path_join(tres_name(file)))
	found.sort()
	return found


## The name a text resource loads under, or "" for another file. In an export a text resource is
## listed as `<name>.tres.remap`, so the gallery on the phone finds the models too.
static func tres_name(file: String) -> String:
	var name: String = file.trim_suffix(".remap")
	return name if name.ends_with(".tres") else ""


## The grid angle `dir` faces, in degrees from +gx towards +gy (ADR 0023 section 1).
static func yaw(dir: int) -> float:
	return (dir - 6) * 22.5


## `res://assets/art/iso/<faction>/<category>/<id>_<part>[_d<NN>][_f<K>].svg`; `dir` -1 and `frame`
## -1 have no suffix.
static func frame_path(model: ArtModel, part: StringName, dir: int, frame: int = -1) -> String:
	return IsoSheetDef.frame_path(model.faction, model.category, model.art_id, part, dir, frame)


## The model's sheet, beside its frames.
static func sheet_path(model: ArtModel) -> String:
	return frame_path(model, &"hull", -1).get_base_dir().path_join("%s_sheet.tres" % model.art_id)


## The model's item card: one folder for both factions, so a build tile finds it by type id.
static func icon_path(model: ArtModel) -> String:
	return ICON_DIR.path_join("item_%s.svg" % model.art_id)


## Every file of the model: its frames (the parts, then the shadow) and their "Keep File" imports,
## its sheet and its item card (a texture import, which Godot writes the `.import` of).
static func build(model: ArtModel) -> Dictionary[String, String]:
	var files: Dictionary[String, String] = {}
	var source: String = "assets/art/models/%s/%s.tres" % [model.faction, model.art_id]
	var shots: Dictionary[StringName, Shot] = all_shots(model)
	for part: StringName in shots:
		var shot: Shot = shots[part]
		for i: int in shot.dirs.size() * shot.frames:
			var dir: int = shot.dirs[i / shot.frames]
			var frame: int = i % shot.frames if shot.frames > 1 else -1
			var path: String = frame_path(model, part, dir, frame)
			var what: String = "%s %s" % [model.art_id, part]
			if dir >= 0:
				what += " d%02d" % dir
			if frame >= 0:
				what += " f%d" % frame
			var comment: String = "%s: %s from %s, do not edit" % [what, MARKER, source]
			var polys: Array[ArtRender.Poly] = []
			polys.assign(shot.polys[i])
			if part == ArtModel.SHADOW:
				files[path] = ArtSvg.shadow(comment, shot.layout.size, shot.layout.origin, polys)
			else:
				files[path] = ArtSvg.frame(comment, shot.layout.size, shot.layout.origin, polys)
			files[path + ".import"] = IMPORT_TEXT
	files[sheet_path(model)] = ArtSheet.text(ArtSheet.of(model, shots))
	files[icon_path(model)] = ArtIcon.card(model)
	return files


## Every file of every model, and the index of the sheets.
static func build_all() -> Dictionary[String, String]:
	var files: Dictionary[String, String] = {}
	for path: String in model_paths():
		files.merge(build(load(path) as ArtModel))
	files[IsoIndex.PATH] = index_text()
	return files


## `assets/art/iso/index.tres`: it lists the sheet of every model, which needs the names only.
static func index_text() -> String:
	var models: Array[ArtModel] = []
	for path: String in model_paths():
		models.append(load(path) as ArtModel)
	return ArtSheet.index_text(models)


## The paths in `files` whose committed file is missing or differs, sorted.
static func stale(files: Dictionary[String, String]) -> Array[String]:
	var found: Array[String] = []
	for path: String in files:
		if not FileAccess.file_exists(path) or FileAccess.get_file_as_string(path) != files[path]:
			found.append(path)
	found.sort()
	return found


## The canvas, origin and anchor of each part of the model, the shadow too.
static func layouts(model: ArtModel) -> Dictionary[StringName, Layout]:
	var found: Dictionary[StringName, Layout] = {}
	var shots: Dictionary[StringName, Shot] = all_shots(model)
	for part: StringName in shots:
		found[part] = shots[part].layout
	return found


## Where the turret or head part's origin lies from the hull's ground point, in px, when the hull
## faces direction `dir`: the mount, turned with the hull and projected.
static func mount_px(model: ArtModel, dir: int) -> Vector2:
	return point_px(model.mount, dir)


## Where a point of the model's frame (tiles) lies from the hull's ground point, in px, when the
## hull faces direction `dir`: turned with the hull and projected. The emitters of a sheet use it.
static func point_px(point: Vector3, dir: int) -> Vector2:
	return ArtRender.project(ArtRender.rotate(point, yaw(dir)))


## The shots of every frame part of the model, in file order.
static func all_shots(model: ArtModel) -> Dictionary[StringName, Shot]:
	var found: Dictionary[StringName, Shot] = {}
	for part: StringName in model.frame_parts():
		if part not in ArtModel.DAMAGE_PARTS:
			found[part] = _shoot(model, part)
		else:
			# A stage that changes nothing has no patch (`problems` refuses such a model).
			var patch: Shot = _shoot_damage(model, part, found[&"hull"])
			if patch != null:
				found[part] = patch
	return found


## The polygons of the whole body at damage `stage`, in the stage's own greedy draw order.
static func stage_polys(model: ArtModel, stage: int) -> Array[ArtRender.Poly]:
	return ArtRender.render(model.damage_prims(stage), 0.0, model.faction)


## How far down a damage stage reaches, as a dictionary: `low`, the lowest screen row (px from the
## model's origin) of the outlines of the primitives the stage changes, as they are intact and as
## the stage poses them, and of where each pair of untouched primitives that the stage draws in
## the other order than the intact body overlaps (the swap shows only there); `prim`, the
## primitive whose outline or overlap sets it, and `swap`, the other one of such a pair (else
## null). `low` is -INF when the stage changes nothing.
static func damage_reach(model: ArtModel, stage: int) -> Dictionary:
	var reach: Dictionary = {"low": -INF, "prim": null, "swap": null}
	for pair: Array in model.damage_changes(stage):
		for prim: ArtPrim in pair:
			if prim != null:
				var low: float = ArtRender.bounds(_outline(model, prim)).end.y
				if low > reach["low"]:
					reach = {"low": low, "prim": prim, "swap": null}
	for pair: Array in model.damage_swaps(stage):
		var low: float = -INF
		for a: ArtRender.Poly in _outline(model, pair[0]):
			for b: ArtRender.Poly in _outline(model, pair[1]):
				for part: PackedVector2Array in Geometry2D.intersect_polygons(a.points, b.points):
					for point: Vector2 in part:
						low = maxf(low, point.y)
		if low > reach["low"]:
			reach = {"low": low, "prim": pair[0], "swap": pair[1]}
	return reach


## The cut row of a stage in the body's canvas (`IsoSheetDef.cuts`): the first row that nothing the
## stage changes can reach. It is the `low` of `damage_reach` plus half the edge that is drawn round
## a face, rounded up to a whole row; so from this row down the stage picture is the intact one.
## `NO_CUT` when the stage changes nothing.
static func damage_cut(model: ArtModel, stage: int, body: Layout) -> int:
	var low: float = damage_reach(model, stage)["low"]
	if is_inf(low):
		return NO_CUT
	return ceili(low + ArtSvg.EDGE_PX / 2.0) + body.origin.y


## What is wrong with the damage stages of a model that is otherwise valid: a stage that changes
## nothing, a change wholly above the body's canvas (the cut would read as "no patch") or one that
## reaches the foot of the body (the overlap would not fit the canvas). A message names the
## primitive (its line in the model, and the pose lines that move it) that sets the lowest row.
static func damage_problems(model: ArtModel) -> PackedStringArray:
	var found: PackedStringArray = PackedStringArray()
	var body: Layout = _shoot(model, &"hull").layout
	for part: StringName in model.damage_parts():
		var stage: int = ArtModel.DAMAGE_PARTS.find(part) + 1
		var cut: int = damage_cut(model, stage, body)
		var what: String = "%s: %s" % [model.art_id, part]
		if cut == NO_CUT:
			found.append("%s changes nothing" % what)
			continue
		var line: String = _describe(model, part, damage_reach(model, stage))
		if cut <= 0:
			found.append("%s: %s is above the canvas of the body" % [what, line])
		elif cut + CUT_OVERLAP_PX > body.size.y:
			found.append(
				(
					"%s: %s reaches below the body (cut row %d, canvas %d rows)"
					% [what, line, cut, body.size.y]
				)
			)
	return found


## The faces of one primitive alone, at the stage's yaw.
static func _outline(model: ArtModel, prim: ArtPrim) -> Array[ArtRender.Poly]:
	var one: Array[ArtPrim] = [prim]
	return ArtRender.render(one, 0.0, model.faction)


## The primitive of a reach as a message names it: `box ...` (line N), the pose lines of `part`
## that move its group, and the other primitive of a swapped pair.
static func _describe(model: ArtModel, part: StringName, reach: Dictionary) -> String:
	var prim: ArtPrim = reach["prim"]
	var text: String = "`%s` (line %d)" % [prim.line, prim.index + 1]
	var moves: PackedStringArray = PackedStringArray()
	for move: ArtMove in model.pose_moves(part, 0):
		if prim.group != &"" and move.group == prim.group:
			moves.append("`%s`" % move.line)
	if not moves.is_empty():
		text += " moved by " + ", ".join(moves)
	var other: ArtPrim = reach["swap"]
	if other != null:
		text += (
			" and `%s` (line %d), drawn in another order than intact, overlap"
			% [other.line, other.index + 1]
		)
	return text


## Where a `hang` point lies for the hull facing `dir`: the bracket is on the side that faces the
## camera (ADR 0028 section 4), so the point is mirrored across the hull's long axis (y to -y) when
## the side it is on turns away from the camera.
static func hang_point_px(point: Vector3, dir: int) -> Vector2:
	var side: Vector3 = ArtRender.rotate(Vector3(0.0, signf(point.y), 0.0), yaw(dir))
	var seen: Vector3 = point
	if side.dot(ArtRender.VIEW) < -1e-6:
		seen.y = -point.y
	return point_px(seen, dir)


## The patch of a damage stage (ADR 0028 section 3): the stage's picture from its top down to the
## cut row and `CUT_OVERLAP_PX` below it, cropped left and right to its ink, in a canvas of its own
## with the body's anchor. The cut row is the lowest screen row of the outlines of the primitives
## the stage changes, as they are intact and as the stage poses them, so below it the stage's
## picture is the intact one; it is read off the geometry, not by comparing pixels.
static func _shoot_damage(model: ArtModel, part: StringName, body: Shot) -> Shot:
	var stage: int = ArtModel.DAMAGE_PARTS.find(part) + 1
	var cut: int = damage_cut(model, stage, body.layout)
	if cut == NO_CUT:
		return null
	var bottom: int = cut + CUT_OVERLAP_PX - body.layout.origin.y
	var polys: Array[ArtRender.Poly] = ArtRender.clip_below(
		stage_polys(model, stage), bottom + ArtSvg.EDGE_PX
	)
	var box: Rect2 = ArtRender.bounds(polys)
	var top: Vector2i = (
		Vector2i(floori(box.position.x), floori(box.position.y)) - Vector2i.ONE * MARGIN_PX
	)
	var right: int = ceili(box.end.x) + MARGIN_PX
	# The canvas is even in both directions: the left and the top edge give way, the bottom is the cut.
	top.x -= (right - top.x) % 2
	top.y -= (bottom - top.y) % 2
	var shot: Shot = Shot.new()
	shot.cut = cut
	shot.dirs.append(-1)
	shot.polys.append(polys)
	shot.layout = Layout.new()
	shot.layout.size = Vector2i(right - top.x, bottom - top.y)
	shot.layout.origin = -top
	shot.layout.anchor = shot.layout.origin - Vector2i(0, TILE_W_PX / 4 * model.footprint)
	return shot


static func _shoot(model: ArtModel, part: StringName) -> Shot:
	var shot: Shot = Shot.new()
	shot.frames = model.frames(part)
	var posed: Array[Array] = []
	for frame: int in shot.frames:
		posed.append(model.frame_prims(part, frame))
	var box: Rect2 = Rect2()
	for dir: int in model.directions(part):
		var turn: float = yaw(dir) if dir >= 0 else 0.0
		for frame: int in shot.frames:
			var prims: Array[ArtPrim] = []
			prims.assign(posed[frame])
			var polys: Array[ArtRender.Poly] = (
				ArtShadow.polys(prims, turn)
				if part == ArtModel.SHADOW
				else ArtRender.render(prims, turn, model.faction, model.frame_rest(part))
			)
			var bounds: Rect2 = ArtRender.bounds(polys)
			box = bounds if shot.polys.is_empty() else box.merge(bounds)
			shot.polys.append(polys)
		shot.dirs.append(dir)
	shot.layout = _layout(box, model.footprint if part in [&"hull", ArtModel.SHADOW] else 0)
	return shot


## The canvas round `box` and the margin; a building's also holds its footprint's diamond, whose
## back corner is the anchor.
static func _layout(box: Rect2, footprint: int) -> Layout:
	var low: Vector2i = (
		Vector2i(floori(box.position.x), floori(box.position.y)) - Vector2i.ONE * MARGIN_PX
	)
	var high: Vector2i = Vector2i(ceili(box.end.x), ceili(box.end.y)) + Vector2i.ONE * MARGIN_PX
	var half: Vector2i = Vector2i(TILE_W_PX / 2, TILE_W_PX / 4) * footprint
	low = low.min(-half)
	high = high.max(half)
	var layout: Layout = Layout.new()
	layout.size = high - low
	layout.size += Vector2i(layout.size.x % 2, layout.size.y % 2)
	layout.origin = -low
	layout.anchor = layout.origin - Vector2i(0, half.y)
	return layout
