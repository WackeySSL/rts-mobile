class_name ArtSheet
extends RefCounted
## The sheets of the generator (ADR 0023 section 5, P99b): `of` reads an `IsoSheetDef` off the
## frames `ArtGen` has just drawn, `text` and `index_text` write it and `assets/art/iso/index.tres`
## as the text of a `.tres`, by hand, so that a run is bytes and a test can compare it with the
## committed file (Godot cannot save a resource to a string).

const MARKER: String = "; generated by tools/artgen from assets/art/models, do not edit"
const SHEET_ID: String = "1_sheet"
## The share of the hull frames that a health bar clears (`bar_lift_px`).
const BAR_CLEARS: float = 0.75
## The exports of an `IsoSheetDef`, in the order they are written.
const FIELDS: Array[StringName] = [
	&"art_id",
	&"faction",
	&"category",
	&"footprint",
	&"parts",
	&"counts",
	&"sizes",
	&"anchors",
	&"mounts",
	&"bar_lift_px",
	&"pick_lift_px",
	&"muzzle_lift_px",
	&"icon",
]


## The sheet of `model`, from the shots of all its frame parts. The lifts are world px at zoom 1.
static func of(model: ArtModel, shots: Dictionary[StringName, ArtGen.Shot]) -> IsoSheetDef:
	var sheet: IsoSheetDef = IsoSheetDef.new()
	sheet.art_id = model.art_id
	sheet.faction = model.faction
	sheet.category = model.category
	sheet.footprint = model.footprint
	sheet.icon = ArtGen.icon_path(model)
	for part: StringName in shots:
		var layout: ArtGen.Layout = shots[part].layout
		sheet.parts.append(String(part))
		sheet.counts.append(shots[part].dirs.size())
		sheet.sizes.append_array([layout.size.x, layout.size.y])
		sheet.anchors.append_array([layout.anchor.x, layout.anchor.y])
	if shots.has(&"turret") or shots.has(&"head"):
		for dir: int in model.directions(&"hull"):
			var at: Vector2 = ArtGen.mount_px(model, 6 if dir < 0 else dir)
			sheet.mounts.append(at.snapped(Vector2.ONE * 0.1))
	sheet.bar_lift_px = ceili(_clearing_top(model, shots) / 2.0)
	sheet.pick_lift_px = roundi(sheet.bar_lift_px / 2.0)
	sheet.muzzle_lift_px = roundi(model.muzzle_z() * ArtRender.Z_PX / 2.0)
	return sheet


## The `.tres` text of a sheet, one value a line in the order of its exports (`var_to_str` writes
## a value as the resource text does; the mounts are written by hand to one decimal).
static func text(sheet: IsoSheetDef) -> String:
	var lines: PackedStringArray = _header("IsoSheetDef", "res://tools/artgen/IsoSheetDef.gd")
	for field: StringName in FIELDS:
		if field == &"mounts":
			var mounts: PackedStringArray = PackedStringArray()
			for mount: Vector2 in sheet.mounts:
				mounts.append("%s, %s" % [ArtSvg.num(mount.x), ArtSvg.num(mount.y)])
			lines.append("mounts = PackedVector2Array(%s)" % ", ".join(mounts))
		else:
			lines.append("%s = %s" % [field, var_to_str(sheet.get(field))])
	return "\n".join(lines) + "\n"


## `index.tres`: the sheet files of `models`, sorted by art id.
static func index_text(models: Array[ArtModel]) -> String:
	var sorted: Array[ArtModel] = models.duplicate()
	sorted.sort_custom(
		func(a: ArtModel, b: ArtModel) -> bool: return String(a.art_id) < String(b.art_id)
	)
	var externals: PackedStringArray = PackedStringArray(
		['[ext_resource type="Script" path="res://tools/artgen/IsoSheetDef.gd" id="%s"]' % SHEET_ID]
	)
	var refs: PackedStringArray = PackedStringArray()
	for model: ArtModel in sorted:
		var path: String = ArtGen.sheet_path(model)
		externals.append(
			'[ext_resource type="Resource" path="%s" id="s_%s"]' % [path, model.art_id]
		)
		refs.append('ExtResource("s_%s")' % model.art_id)
	var lines: PackedStringArray = _header("IsoIndex", "res://tools/artgen/IsoIndex.gd", externals)
	lines.append('sheets = Array[ExtResource("%s")]([%s])' % [SHEET_ID, ", ".join(refs)])
	return "\n".join(lines) + "\n"


## The lines of a `.tres` up to the first value of `[resource]`: the marker, the type, the script
## and the `externals` (more `ext_resource` lines).
static func _header(
	type_name: String, script: String, externals: PackedStringArray = PackedStringArray()
) -> PackedStringArray:
	var lines: PackedStringArray = PackedStringArray(
		[
			MARKER,
			'[gd_resource type="Resource" script_class="%s" format=3]' % type_name,
			"",
			'[ext_resource type="Script" path="%s" id="0_script"]' % script,
		]
	)
	lines.append_array(externals)
	lines.append_array(["", "[resource]", 'script = ExtResource("0_script")'])
	return lines


## How high the picture reaches above the ground point (px of the 2x art) in the pose that a share
## `BAR_CLEARS` of the hull frames stay under, the turret or head straight ahead in each: a bar
## standing on it clears at least that share of the poses, and covers only a taller one (a long
## hull, or a barrel that points up the screen, which "Health bars" allows).
static func _clearing_top(model: ArtModel, shots: Dictionary[StringName, ArtGen.Shot]) -> float:
	var hull: ArtGen.Shot = shots[&"hull"]
	var tops: Array[float] = []
	for i: int in hull.dirs.size():
		var top: float = -_top(hull.polys[i])
		var dir: int = 6 if hull.dirs[i] < 0 else hull.dirs[i]
		for part: StringName in [&"turret", &"head"]:
			if shots.has(part):
				var at: Vector2 = ArtGen.mount_px(model, dir)
				top = maxf(top, -(at.y + _top(shots[part].polys[dir])))
		tops.append(top)
	tops.sort()
	return tops[ceili(tops.size() * BAR_CLEARS) - 1]


## The highest point of a frame's polygons (the smallest y, negative above the ground point).
static func _top(polys: Array) -> float:
	var typed: Array[ArtRender.Poly] = []
	typed.assign(polys)
	return ArtRender.bounds(typed).position.y
